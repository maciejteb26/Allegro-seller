# App
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001

# Database (lokalnie: docker-compose; produkcja: Supabase — patrz docs/SUPABASE.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/szybkiewystawianie
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/szybkiewystawianie
# Supabase prod — skopiuj z .env.supabase.example:
# DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[pass]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://[ref].supabase.co

# JWT
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!!

# Encryption (AES-256 dla tokenów OAuth) — dokładnie 32 znaki
ENCRYPTION_KEY=change-me-exactly-32-chars-long!!

# Storage (lokalnie: MinIO; produkcja: Supabase Storage S3 — patrz docs/SUPABASE.md)
# MinIO (dev):
S3_ENDPOINT=http://localhost:9000
# Supabase (prod): pomiń S3_ENDPOINT gdy SUPABASE_URL ustawione
# S3_ENDPOINT=https://[ref].storage.supabase.co/storage/v1/s3
S3_BUCKET=szybkiewystawianie-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI — Anthropic (SEO import + parser). Wymaga ANTHROPIC_API_KEY gdy AI_MOCK=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MOCK=false

# Wyszukiwanie — wymaga SERPAPI_KEY lub GOOGLE_CSE_* gdy EXTERNAL_SEARCH_MOCK=false
SERPAPI_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
EXTERNAL_SEARCH_MOCK=false

# Email (reset hasła). Resend (zalecane) LUB SMTP — patrz docs/EMAIL.md
# Dev (bez weryfikacji domeny): onboarding@resend.dev
# Prod (po DNS): noreply@szybkiewystawianie.pl
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
# SMTP (alternatywa):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_MOCK=false

# Allegro — realne API (wymaga OAuth + klucze aplikacji)
ALLEGRO_MOCK=false
ALLEGRO_SANDBOX=true
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:3001/api/platforms/allegro/oauth/callback
ALLEGRO_USER_AGENT=SzybkieWystawianie/0.1.0
