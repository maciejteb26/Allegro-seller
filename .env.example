# App
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allegro_seller
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/allegro_seller

# JWT
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!!

# Encryption (AES-256 dla tokenów OAuth) — dokładnie 32 znaki
ENCRYPTION_KEY=change-me-exactly-32-chars-long!!

# Storage (lokalnie: MinIO, produkcja: S3/R2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=allegro-seller-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI — Anthropic (SEO import + parser). Bez klucza: AI_MOCK=true (domyślnie)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MOCK=true

# Wyszukiwanie produktów (Google + sprzedawcy). Bez klucza: EXTERNAL_SEARCH_MOCK=true
SERPAPI_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
EXTERNAL_SEARCH_MOCK=true

# Allegro — MOCK MODE (true = brak prawdziwego API)
ALLEGRO_MOCK=true
ALLEGRO_SANDBOX=true
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:3001/api/platforms/allegro/oauth/callback
ALLEGRO_USER_AGENT=AllegroSeller/0.1.0
