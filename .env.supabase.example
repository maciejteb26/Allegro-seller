# Szablon produkcyjny: Supabase (Postgres + Storage)
# Skopiuj do server/.env lub ustaw w Render Dashboard.
# Pełna instrukcja: docs/SUPABASE.md

NODE_ENV=production
PORT=3001
CLIENT_URL=https://szybkiewystawianie.pl

# --- Supabase Postgres (Dashboard → Connect) ---
# Runtime: Transaction pooler :6543 + ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migracje Prisma / seed: Session pooler :5432 LUB direct db.[ref].supabase.co:5432
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase (opcjonalne — auto-endpoint Storage) ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PROJECT_REF=[PROJECT_REF]

# --- Supabase Storage S3 (Dashboard → Storage → S3 Access Keys) ---
# S3_ENDPOINT można pominąć gdy SUPABASE_URL jest ustawione (auto: *.storage.supabase.co)
# S3_ENDPOINT=https://[PROJECT_REF].storage.supabase.co/storage/v1/s3
S3_BUCKET=szybkiewystawianie
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth aplikacji (własny JWT — nie Supabase Auth) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# --- Reszta jak w .env.example ---
ALLEGRO_MOCK=true
ALLEGRO_SANDBOX=true
ALLEGRO_REDIRECT_URI=https://[API_HOST]/api/platforms/allegro/oauth/callback
ALLEGRO_USER_AGENT=SzybkieWystawianie/0.1.0
